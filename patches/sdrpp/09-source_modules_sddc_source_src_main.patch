+    // Search for SDDC_FX3.img in the usual places. Returns an empty string if not found.
+    static std::string resolveFirmwarePath(const std::string& configured) {
+        std::vector<std::string> candidates;
+        if (!configured.empty()) { candidates.push_back(configured); }
+
+        const char* env = std::getenv("SDDC_FIRMWARE");
+        if (env && env[0]) { candidates.push_back(std::string(env)); }
+
+        const std::string root = core::args["root"].s();
+        candidates.push_back(root + "/SDDC_FX3.img");
+        candidates.push_back(root + "/firmware/SDDC_FX3.img");
+        candidates.push_back(root + "/res/SDDC_FX3.img");
+        candidates.push_back("/usr/share/sddc/SDDC_FX3.img");
+        candidates.push_back("/usr/local/share/sddc/SDDC_FX3.img");
+
+        const char* home = std::getenv("HOME");
+        if (home && home[0]) {
+            const std::string h(home);
+            candidates.push_back(h + "/.local/share/sddc/SDDC_FX3.img");
+            candidates.push_back(h + "/sdr/SDDC_FX3.img");
+            candidates.push_back(h + "/sdr/ExtIO_sddc/SDDC_FX3.img");
+        }
+
+        for (const std::string& c : candidates) {
+            if (c.empty()) { continue; }
+            std::error_code ec;
+            if (std::filesystem::exists(c, ec) && !ec) { return c; }
+        }
+        return "";
+    }
